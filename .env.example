# Server-only. Provision one Supabase Auth user, disable signups, apply migration,
# and add that user's UUID to public.desk_owners. Never commit .env.local.
SUPABASE_URL=
SUPABASE_ANON_KEY=
OWNER_ID=
# Optional generation; choose a currently supported structured-output model.
GEMINI_API_KEY=
GEMINI_MODEL=
# Scheduled sync is not implemented yet; see docs/deployment.md.
# Explicitly enable synthetic fixture seeding outside production only.
ALLOW_FIXTURE_SEED=false
