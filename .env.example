# Server-only. Provision one Supabase Auth user, disable signups, apply migration,
# and add that user's UUID to public.desk_owners. Never commit .env.local.
SUPABASE_URL=
# Open the local workspace without sign-in; stored separately in .local/.
# Leave false on hosted deployments.
LOCAL_OPEN_ACCESS=false
SUPABASE_ANON_KEY=
OWNER_ID=
# Optional generation; choose a currently supported structured-output model.
GEMINI_API_KEY=
GEMINI_MODEL=
# Server-only scheduled collection; apply the additive worker migration first.
SUPABASE_SERVICE_ROLE_KEY=
# At least 32 random characters; also stored in Supabase Vault for cron dispatch.
CRON_SECRET=
# Explicitly enable synthetic fixture seeding outside production only.
ALLOW_FIXTURE_SEED=false
